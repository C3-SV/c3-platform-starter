{
  "name": "c3-platform",
  "private": true,
  "version": "0.1.0",
  "description": "MVP funcional de C3 Platform: Compite, Crea, Conecta y Challenges",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run check:vercel-env && next build",
    "check:vercel-env": "node scripts/check-vercel-env.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test \"tests/unit/*.test.ts\"",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-c3-platform \"node --experimental-strip-types --test --test-concurrency=1 \\\"tests/emulator/*.test.ts\\\"\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-c3-platform \"node --experimental-strip-types scripts/run-e2e.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-c3-platform",
    "seed:dry-run": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed.mjs --mode dry-run",
    "seed:apply": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed.mjs --mode apply",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "firebase-tools": "^15.33.0",
    "typescript": "~5.9.3"
  },
  "type": "module"
}
