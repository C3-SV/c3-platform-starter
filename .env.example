# Variables públicas del SDK cliente de Firebase (no son contraseñas).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Opcional, si la app usa otras capacidades de Firebase.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Para procesos confiables del servidor: preferir Application Default Credentials
# (credenciales del entorno o identidad administrada en hosting).
# NUNCA colocar credenciales privadas en NEXT_PUBLIC_*
GOOGLE_CLOUD_PROJECT=
