# Variables públicas del SDK cliente de Firebase (no son contraseñas).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Desarrollo local con emuladores: true. En proyecto real: false o sin definir.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# Proyecto del servidor (Admin SDK). Credenciales: Application Default Credentials
# o identidad administrada del hosting. NUNCA colocar claves privadas en NEXT_PUBLIC_*.
GOOGLE_CLOUD_PROJECT=

# Producción en Vercel: alternativa explícita a ADC. Usá variables privadas,
# nunca NEXT_PUBLIC_*. Se recomienda el JSON completo para evitar errores de saltos de línea.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternativa al JSON completo:
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Solo para desarrollo con emuladores (las define `npm run emulators` cuando se usa test:rules;
# para `npm run dev` con emuladores, declararlas aquí).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
