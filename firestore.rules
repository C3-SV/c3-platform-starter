rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Denegar TODO desde el cliente. Todas las lecturas y escrituras de la aplicación
    // pasan por rutas de servidor con Firebase Admin SDK, que verifican el token de Firebase
    // y el permiso de cada recurso antes de tocar datos.
    // El contenido público se sirve desde el servidor para filtrar campos internos
    // (autor, borradores, notas). Abrir lecturas directas exigiría reglas por campo.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
